{
  "name": "nsc-ict-service-desk-backend",
  "version": "1.0.0",
  "description": "Backend API for the NSC ICT Service Desk and Asset Management System",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "migrate": "node src/scripts/runMigrations.js",
    "expire-accounts": "node src/scripts/expireAccounts.js",
    "notification-queue": "node src/scripts/runNotificationQueue.js",
    "maintenance-monitor": "node src/scripts/runMaintenanceMonitor.js",
    "sla-monitor": "node src/scripts/runSlaMonitor.js",
    "secret-scan": "node src/scripts/secretScan.js",
    "smoke": "node src/scripts/smokeCheck.js",
    "ci": "npm test && npm run secret-scan",
    "release:check": "npm test && npm run secret-scan && npm audit --audit-level=high && npm pack --dry-run",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node test/run.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
