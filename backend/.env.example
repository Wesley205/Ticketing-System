# Copy this file to ".env" in the same folder and fill in local values.
# Never commit real credentials.

# PostgreSQL connection
# Hosted deployments may use DATABASE_URL instead of the individual PG variables.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=nsc_ict_system
PGUSER=postgres
PGPASSWORD=replace_with_your_postgres_password

# Server
PORT=5000
NODE_ENV=development
INTERNAL_APP_BASE_URL=http://localhost:5000
JSON_BODY_LIMIT=6mb
URLENCODED_BODY_LIMIT=1mb
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
ORGANIZATION_EMAIL_DOMAINS=localhost
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Production database security and pool sizing
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=10
PGIDLE_TIMEOUT_MS=30000
PGCONNECTION_TIMEOUT_MS=10000

# Account lifecycle
ACCOUNT_EXPIRY_SWEEP_INTERVAL_MINUTES=60
ACCOUNT_EXPIRY_SWEEP_ON_START=true

# Staff invitations
INVITATION_TOKEN_BYTES=24

# Ticket attachments
TICKET_ATTACHMENT_MAX_BYTES=2097152
TICKET_IMAGE_ATTACHMENT_LIMIT=3
IMAGE_MEDIA_MAX_BYTES=2097152
# Use local for Docker. Use vercel-blob only after connecting a private Blob store.
MEDIA_STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=

# SLA monitoring
SLA_MONITOR_INTERVAL_MINUTES=15
SLA_MONITOR_ON_START=true
# Comma-separated warning stages. Each stage is sent once before the SLA deadline.
SLA_WARNING_THRESHOLDS=50,75,90

# Notification queue
NOTIFICATION_QUEUE_INTERVAL_MINUTES=10
NOTIFICATION_QUEUE_ON_START=true
NOTIFICATION_MAX_ATTEMPTS=5

# Preventive maintenance reminders
MAINTENANCE_MONITOR_INTERVAL_MINUTES=60
MAINTENANCE_MONITOR_ON_START=true

# Hosted free-tier recovery job
# Generate a random value of at least 32 characters for hosted deployment.
CRON_SECRET=

# Optional email delivery
# Keep disabled unless SMTP is actually configured and verified.
# Use EMAIL_DELIVERY_MODE=smtp to send invitation and notification emails.
EMAIL_DELIVERY_MODE=
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional browser push notifications
# Generate VAPID keys with: npx web-push generate-vapid-keys
# WEB_PUSH_CONTACT_EMAIL is preferred and will be converted to a mailto subject.
WEB_PUSH_CONTACT_EMAIL=admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
