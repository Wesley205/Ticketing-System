# Copy this file to ".env" in the same folder and fill in local values.
# Never commit real credentials.

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=nsc_ict_system
PGUSER=postgres
PGPASSWORD=replace_with_your_postgres_password

# Server
PORT=5000
NODE_ENV=development
INTERNAL_APP_BASE_URL=http://localhost:5000
JSON_BODY_LIMIT=6mb

# Security
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
ORGANIZATION_EMAIL_DOMAINS=nscict.local

# Account lifecycle
ACCOUNT_EXPIRY_SWEEP_INTERVAL_MINUTES=60
ACCOUNT_EXPIRY_SWEEP_ON_START=true

# Ticket attachments
TICKET_ATTACHMENT_MAX_BYTES=2097152

# SLA monitoring
SLA_MONITOR_INTERVAL_MINUTES=15
SLA_MONITOR_ON_START=true

# Notification queue
NOTIFICATION_QUEUE_INTERVAL_MINUTES=10
NOTIFICATION_QUEUE_ON_START=true
NOTIFICATION_MAX_ATTEMPTS=5

# Preventive maintenance reminders
MAINTENANCE_MONITOR_INTERVAL_MINUTES=60
MAINTENANCE_MONITOR_ON_START=true

# Optional email delivery
# Keep disabled unless SMTP is actually configured and verified.
EMAIL_DELIVERY_MODE=
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
